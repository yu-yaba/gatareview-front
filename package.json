{
  "name": "app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "verify": "npm run lint && npm run typecheck && npm run test:auth-options && npm run test:mutations && npm run test:lecture-search && npm run test:public-review && npm run test:monitoring && npm run test:pwa-domains && npm run e2e:smoke",
    "test:auth-options": "node --test tests/unit/auth-options-log.test.cjs tests/unit/client-ip-signature.test.cjs",
    "e2e:install": "playwright install chromium",
    "e2e": "playwright test",
    "e2e:security": "playwright test -c playwright.security.config.ts",
    "e2e:csp": "playwright test -c playwright.csp.config.ts",
    "test:public-cache": "node tests/cache/public-lecture-cache.mjs",
    "test:lecture-streaming": "node tests/cache/lecture-streaming.mjs",
    "e2e:headed": "playwright test --headed",
    "e2e:smoke": "playwright test tests/e2e/review-access.smoke.spec.ts --project=chromium",
    "test:mutations": "node --test tests/unit/api-mutations.test.cjs",
    "test:lecture-search": "node --test tests/unit/lecture-search.test.cjs",
    "test:public-review": "node --test tests/unit/public-review.test.cjs",
    "test:search-cache": "node tests/cache/lecture-search-cache.mjs",
    "test:monitoring": "node --test tests/unit/monitoring.test.cjs",
    "test:pwa-domains": "node --test tests/unit/pwa-advertising-hosts.test.cjs"
  },
  "dependencies": {
    "@sentry/nextjs": "11.11.0",
    "@tailwindcss/postcss": "4.3.4",
    "@types/grecaptcha": "^3.0.9",
    "@types/lodash": "^4.17.27",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "axios": "^1.21.0",
    "eslint-config-next": "15.5.28",
    "js-cookie": "^3.0.8",
    "lodash": "^4.18.1",
    "next": "15.5.28",
    "next-auth": "^4.24.15",
    "next-pwa": "^5.6.0",
    "postcss": "8.5.32",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-dropzone": "^14.2.3",
    "react-icons": "^4.9.0",
    "react-modal": "^3.16.1",
    "react-paginate": "^8.2.0",
    "react-toastify": "^11.2.0",
    "swiper": "12.1.2",
    "tailwindcss": "4.3.4",
    "typescript": "5.2.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/js-cookie": "^3.0.6",
    "@types/minimatch": "^6.0.0",
    "@types/prop-types": "15.7.15",
    "@types/react-modal": "^3.16.0",
    "@types/react-stars": "^2.2.1",
    "eslint": "8.57.1",
    "react-stars": "^2.2.5"
  },
  "overrides": {
    "@babel/plugin-transform-modules-systemjs": "7.29.4",
    "form-data": "4.0.6",
    "postcss": "8.5.32",
    "serialize-javascript": "7.1.3",
    "uuid": "11.1.1",
    "sharp": "0.35.5",
    "postcss-selector-parser": "7.1.6",
    "browserslist": "^4.28.7"
  },
  "engines": {
    "node": ">=24.22.1 <25"
  }
}
